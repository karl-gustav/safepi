#!/bin/bash


mounts=()
pi_args=()

if [ "${1:-}" = "--session" ]; then
  pi_args+=("--session" "$2")
  shift 2
fi

mounts+=("-v" "$PWD:/workspace")

for path in "$@"; do
  abs_path="$(realpath "$path")"
  name="$(basename "$abs_path")"

  mounts+=("-v" "$abs_path:/mnt/$name")
done

docker run -it --rm \
  "${mounts[@]}" \
  -v "$HOME/.pi:/home/piuser/.pi" \
  safepi \
  "${pi_args[@]}"
